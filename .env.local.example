# Environment Variables for AuraFlow (Local Development)
# 
# COPY this file to .env.local and fill in your actual values
# .env.local is git-ignored and will not be committed
#

# ============================================================================
# Upstash Redis Configuration (REQUIRED)
# ============================================================================
# Get these from https://console.upstash.com
#
# Steps to get credentials:
# 1. Sign up at https://upstash.com (free tier available)
# 2. Create a Redis database
# 3. Copy REST URL and token from database details
#

UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here


# ============================================================================
# CORS Configuration (OPTIONAL)
# ============================================================================
# Comma-separated list of allowed origins
# Defaults to http://localhost:5173 if not set
#

CORS_ORIGIN=http://localhost:5173,http://localhost:3000


# ============================================================================
# Frontend API URL (OPTIONAL)
# ============================================================================
# For local development, leave empty or comment out
# For production on Vercel, set to your Vercel app URL
#

# VITE_API_URL=http://localhost:3000
# VITE_API_URL=https://your-app.vercel.app
